{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "\"${XDG_CONFIG_HOME:-$HOME/.config}/agent-dotfiles/scripts/agent-state\" claude SessionStart"}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "\"${XDG_CONFIG_HOME:-$HOME/.config}/agent-dotfiles/scripts/agent-state\" claude UserPromptSubmit"}]}
    ],
    "PreToolUse": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "\"${XDG_CONFIG_HOME:-$HOME/.config}/agent-dotfiles/scripts/agent-state\" claude PreToolUse"}]}
    ],
    "Notification": [
      {"hooks": [{"type": "command", "command": "\"${XDG_CONFIG_HOME:-$HOME/.config}/agent-dotfiles/scripts/agent-state\" claude Notification"}]}
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "\"${XDG_CONFIG_HOME:-$HOME/.config}/agent-dotfiles/scripts/agent-state\" claude SubagentStart"}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "\"${XDG_CONFIG_HOME:-$HOME/.config}/agent-dotfiles/scripts/agent-state\" claude SubagentStop"}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "\"${XDG_CONFIG_HOME:-$HOME/.config}/agent-dotfiles/scripts/agent-state\" claude Stop"}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "\"${XDG_CONFIG_HOME:-$HOME/.config}/agent-dotfiles/scripts/agent-state\" claude SessionEnd"}]}
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"${XDG_CONFIG_HOME:-$HOME/.config}/agent-dotfiles/scripts/claude-statusline\"",
    "padding": 0,
    "refreshInterval": 5
  }
}
