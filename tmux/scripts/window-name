#!/usr/bin/env bash
set -u

command_name=${1:-}
current_path=${2:-}
pane_tty=${3:-}

case "$command_name" in
  [0-9]*[._][0-9]*[._][0-9]*) command_name=claude ;;
esac

if [ "$command_name" = node ] && [ -n "$pane_tty" ]; then
  tty_base=${pane_tty#/dev/}
  detected=$(ps -t "$tty_base" -o comm= 2>/dev/null | grep -m1 -xE 'claude|codex|aider|opencode' || true)
  [ -n "$detected" ] && command_name=$detected
fi

name=$(basename "$current_path")
if git -C "$current_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  root=$(git -C "$current_path" rev-parse --show-toplevel 2>/dev/null || true)
  branch=$(git -C "$current_path" symbolic-ref --short HEAD 2>/dev/null || git -C "$current_path" rev-parse --short HEAD 2>/dev/null || true)
  [ -n "$root" ] && name=$(basename "$root")
  [ -n "$branch" ] && name="$name@$branch"
fi

case "$command_name" in
  claude|codex|aider|opencode) printf '%s · %s\n' "$command_name" "$name" ;;
  *) printf '%s\n' "$name" ;;
esac
