#!/usr/bin/env bash
set -u

provider=${1:-agent}
event=${2:-}
cat >/dev/null 2>&1 || true

if [ -z "${TMUX:-}" ] || [ -z "${TMUX_PANE:-}" ] || ! command -v tmux >/dev/null 2>&1; then
  exit 0
fi

set_window_option() {
  tmux set-option -wq -t "$TMUX_PANE" "$1" "$2" 2>/dev/null || true
}

subagent_count() {
  value=$(tmux show-option -wv -t "$TMUX_PANE" @agent_subagents 2>/dev/null || true)
  case "$value" in
    ''|*[!0-9]*) printf '0\n' ;;
    *) printf '%s\n' "$value" ;;
  esac
}

change_subagent_count() {
  count=$(subagent_count)
  if [ "$1" = up ]; then
    count=$((count + 1))
  elif [ "$count" -gt 0 ]; then
    count=$((count - 1))
  fi
  set_window_option @agent_subagents "$count"
}

state=working
notify=false
case "$event" in
  SessionStart) state=idle; set_window_option @agent_subagents 0 ;;
  UserPromptSubmit|PostToolUse) state=working ;;
  PreToolUse) state=working ;;
  SubagentStart) state=working; change_subagent_count up ;;
  SubagentStop) state=working; change_subagent_count down ;;
  Notification|PermissionRequest|Interrupt) state=waiting; notify=true ;;
  Stop) state=done; notify=true ;;
  SessionEnd)
    set_window_option @agent_state ''
    set_window_option @agent_provider ''
    set_window_option @agent_subagents 0
    exit 0
    ;;
  *) exit 0 ;;
esac

set_window_option @agent_provider "$provider"
set_window_option @agent_state "$state"

if [ "$notify" = true ]; then
  script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  "$script_dir/agent-notify" "$provider" "$state" >/dev/null 2>&1 &
fi

exit 0
